{
  "identifier": "main",
  "description": "Diagnostic commands in the main local window only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-relaunch",
    "allow-auth-status",
    "allow-auth-sign-in-google",
    "allow-auth-retry",
    "allow-auth-sign-out",
    "allow-workspace-members",
    "allow-workspace-add-member",
    "allow-workspace-remove-member",
    "allow-runtime-start",
    "allow-runtime-health",
    "allow-runtime-stop",
    "allow-runtime-status",
    "allow-runtime-restart",
    "allow-account-select",
    "allow-teaching-request",
    "allow-proof-connect",
    "allow-voice-status",
    "allow-voice-enable",
    "allow-voice-disable",
    "allow-voice-set-transcription-language",
    "allow-voice-execute-text",
    "allow-voice-cancel",
    "allow-device-readiness",
    "allow-device-permission-request",
    "allow-device-permission-settings"
  ]
}
