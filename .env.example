# Reference only. npm run setup creates ignored .local/environment.json and profiles.json.
# No provider credentials are used by P0.
TRO_FIXTURE_MODE=1
TRO_API_BIND=127.0.0.1:4318
DATABASE_URL=postgres://fixture:GENERATED_LOCALLY@127.0.0.1:55439/tro_rebuild_test
TRO_S3_ENDPOINT=http://127.0.0.1:19000
TRO_S3_KEY=tro-fixture
TRO_S3_SECRET=GENERATED_LOCALLY

# Hosted authentication (reference names only; supply secrets through the
# deployment secret manager, never this file).
TRO_API_MODE=hosted
TRO_AUTH_ISSUER=https://api.example.com
TRO_AUTH_AUDIENCE=tro-desktop-api
TRO_GOOGLE_CLIENT_ID=YOUR_DESKTOP_CLIENT_ID.apps.googleusercontent.com
TRO_JWT_KEY_B64=GENERATE_AT_LEAST_32_RANDOM_BYTES_AS_BASE64
TRO_REFRESH_KEY_B64=GENERATE_A_DIFFERENT_32_BYTE_BASE64_SECRET
TRO_ACCESS_TTL_SECONDS=900
TRO_REFRESH_TTL_SECONDS=2592000
OPENAI_API_KEY=SUPPLY_FROM_DEPLOYMENT_SECRET_MANAGER
TRO_TRANSCRIPTION_MODEL=gpt-transcribe
TRO_ACTION_MODEL=computer-use-preview

# Native desktop public configuration.
TRO_AUTH_API_ORIGIN=https://api.example.com
