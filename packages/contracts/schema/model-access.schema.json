{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelAccess",
  "type": "object",
  "properties": {
    "providerEnabled": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "P0_DIAGNOSTIC_ONLY"
      ]
    }
  },
  "required": [
    "providerEnabled",
    "accountId",
    "reason"
  ],
  "additionalProperties": false
}
