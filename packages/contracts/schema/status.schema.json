{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeStatus",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "running",
        "stopping",
        "stopped",
        "failed"
      ]
    },
    "generationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "message": {
      "type": "string",
      "maxLength": 256
    }
  },
  "additionalProperties": false,
  "required": [
    "state",
    "generationId",
    "revision",
    "message"
  ]
}
