{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthStatus",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "checking",
        "signedOut",
        "signingIn",
        "authenticated",
        "membershipRequired",
        "offline",
        "error"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configured": {
      "type": "boolean"
    },
    "retryable": {
      "type": "boolean"
    },
    "user": {
      "oneOf": [
        {
          "$ref": "#/definitions/AuthUser"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaces": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/WorkspaceSummary"
      }
    },
    "accessTokenExpiresAt": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "state",
    "revision",
    "message",
    "configured",
    "retryable",
    "user",
    "workspaces",
    "accessTokenExpiresAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "authenticated"
          }
        }
      },
      "then": {
        "properties": {
          "configured": {
            "const": true
          },
          "user": {
            "$ref": "#/definitions/AuthUser"
          },
          "workspaces": {
            "type": "array",
            "minItems": 1
          },
          "accessTokenExpiresAt": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "membershipRequired"
          }
        }
      },
      "then": {
        "properties": {
          "configured": {
            "const": true
          },
          "user": {
            "$ref": "#/definitions/AuthUser"
          },
          "workspaces": {
            "type": "array",
            "maxItems": 0
          },
          "accessTokenExpiresAt": {
            "type": "string"
          }
        }
      }
    }
  ],
  "definitions": {
    "AuthUser": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        }
      },
      "required": ["accountId", "displayName", "email"],
      "additionalProperties": false
    },
    "WorkspaceSummary": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["owner", "teacher", "student"]
        }
      },
      "required": ["workspaceId", "name", "role"],
      "additionalProperties": false
    }
  }
}
