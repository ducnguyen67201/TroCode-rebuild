{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NativeProofEvidence",
  "definitions": {
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["pass", "fail", "not_run"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "Timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localTransition", "stop", "model"],
      "properties": {
        "localTransition": { "$ref": "#/definitions/TimingSamples" },
        "stop": { "$ref": "#/definitions/TimingSamples" },
        "model": { "$ref": "#/definitions/TimingSamples" }
      }
    },
    "TimingSamples": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "number", "minimum": 0, "maximum": 3600000 }
    }
  },
  "oneOf": [
    {
      "title": "NativeProofEvidenceV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "os", "arch", "installerSha256", "signing", "tester", "observedAt", "checks"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "enum": ["arm64", "x64"] },
        "installerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signing": { "enum": ["unsigned", "ad-hoc", "signed", "notarized"] },
        "tester": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cleanInstall", "permissionAttribution", "clickThrough", "allGesturesManual", "zeroInjectedInput", "freshChecks", "stopDuringWork", "accountIsolation", "mixedDpi", "realModel"],
          "properties": {
            "cleanInstall": { "type": "boolean" },
            "permissionAttribution": { "type": "boolean" },
            "clickThrough": { "type": "boolean" },
            "allGesturesManual": { "type": "boolean" },
            "zeroInjectedInput": { "type": "boolean" },
            "freshChecks": { "type": "boolean" },
            "stopDuringWork": { "type": "boolean" },
            "accountIsolation": { "type": "boolean" },
            "mixedDpi": { "type": "boolean" },
            "realModel": { "type": "boolean" }
          }
        }
      }
    },
    {
